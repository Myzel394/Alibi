    <string name="ui_welcome_timeSettings_values_15min">15 minut</string>
    <string name="ui_welcome_timeSettings_values_30min">30 minut</string>
    <string name="ui_welcome_timeSettings_values_1hour">1 hodina</string>
    <string name="ui_welcome_timeSettings_changeableHint">Toto nastavení můžete kdykoli změnit</string>
    <string name="ui_welcome_saveFolder_title">Kam má Alibi ukládat dávky?</string>
    <string name="ui_welcome_saveFolder_message">Vyberte, kam chcete, aby Alibi ukládalo dávky probíhajících nahrávek. Interní složka je šifrovaná a přístupná pouze pro Alibi. Tato složka se doporučuje, pokud chcete nahrávat pouze krátké časové úseky. Pokud potřebujete delší časové úseky, budete pravděpodobně muset vybrat jinou složku, protože interní úložiště je velmi omezené.</string>
