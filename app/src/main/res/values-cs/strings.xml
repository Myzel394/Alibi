    <string name="ui_settings_option_saveFolder_externalPermissionRequired_title">Vyžadováno oprávnění</string>
    <string name="ui_settings_option_saveFolder_externalPermissionRequired_text">Pro přístup ke složce DCIM musíte aplikaci Alibi udělit oprávnění k přístupu k externímu úložišti. Alibi použije toto oprávnění pouze pro zápis vašich záznamů do složky DCIM.</string>
